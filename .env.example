# Supabase Auth (Project Settings > API) -- solo se usa para login/sesion
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Conexion Postgres para TypeORM (Project Settings > Database > Connection string > URI;
# usa el "Session pooler" si vas a desplegar en Vercel/serverless)
DATABASE_URL=

# URL publica de la app (usada para validar la firma de Twilio; en local usa la URL de ngrok)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic (agente de WhatsApp)
ANTHROPIC_API_KEY=

# Twilio WhatsApp sandbox (Console > Messaging > Try it out > WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Numero(s) de WhatsApp autorizados a consultar el agente (formato whatsapp:+52..., separados por coma)
WHATSAPP_OWNER_NUMBERS=
